{
    "name": "@copetti/charts",
    "version": "1.0.0",
    "description": "Modern TypeScript charting library with React and Radix UI",
    "type": "module",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:lib": "bun run build:types && bun run build:bundle",
        "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
        "build:bundle": "vite build --mode lib",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist node_modules/.vite"
    },
    "keywords": [
        "charts",
        "typescript",
        "react",
        "canvas",
        "financial",
        "trading",
        "radix"
    ],
    "author": "Copetti",
    "license": "MPL-2.0",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/bun": "latest",
        "@types/color": "^4.2.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "eslint": "^9.39.2",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^17.0.0",
        "jsdom": "^27.4.0",
        "prettier": "^3.7.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.51.0",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/themes": "^3.2.1",
        "@tailwindcss/postcss": "^4.0.0",
        "color": "^5.0.3",
        "date-fns": "^4.1.0",
        "framer-motion": "^11.18.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "rxjs": "^7.8.2",
        "tailwindcss": "^4.0.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "bun": ">=1.0.0"
    }
}
